DATA=$'\
# colon (:)
u1:Alice::Admin:1001:ops:/bin/bash
u2:Bob:Sales::1002:ops:/usr/sbin/nologin
u3::Eng:Dev:1003::/bin/sh
:Lead:PM::1004:ops:/bin/zsh
u5:Eve:Sec:IR:1005:ops:
u6:Zed:Ops:OnCall:1006:ops:/bin/bash:EXTRA1:EXTRA2
# pipe (|)
u1|Alice||Admin|1001|ops|/bin/bash
u2|Bob|Sales||1002|ops|/usr/sbin/nologin
u3||Eng|Dev|1003||/bin/sh
|Lead|PM||1004|ops|/bin/zsh
u5|Eve|Sec|IR|1005|ops|
u6|Zed|Ops|OnCall|1006|ops|/bin/bash|EXTRA1|EXTRA2
# comma (,)
u1,Alice,,Admin,1001,ops,/bin/bash
u2,Bob,Sales,,1002,ops,/usr/sbin/nologin
u3,,Eng,Dev,1003,,/bin/sh
,Lead,PM,,1004,ops,/bin/zsh
